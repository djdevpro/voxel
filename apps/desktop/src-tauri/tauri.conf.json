{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxel",
  "version": "0.2.0",
  "identifier": "dev.voxel.desktop",
  "build": {
    "beforeDevCommand": "npm -w @voxel/web run dev -- --port 5373 --strictPort",
    "devUrl": "http://localhost:5373",
    "beforeBuildCommand": "npm -w @voxel/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost wss://api.deepgram.com",
        "frame-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "manifest-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] },
      "rpm": { "depends": ["libayatana-appindicator3.so.1()(64bit)"] },
      "appimage": {
        "files": { "/usr/lib/libayatana-appindicator3.so.1": "/usr/lib/x86_64-linux-gnu/libayatana-appindicator3.so.1" }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENzcwMEE1OUQzNDUzMEYKUldRUFV6U2RwUUIzWGNoNGxUZ3dLU2JkbWxlV3dLdkhyRzFkdVp3eUJ5bXlENVc4d3BrWkxhOUEK",
      "endpoints": ["https://github.com/djdevpro/voxel/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
