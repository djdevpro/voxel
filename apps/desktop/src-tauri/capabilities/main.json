{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Droits de l'interface de Voxel. Le HTML des mails, dans son iframe sans scripts, n'en reçoit aucun.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-hide", "core:window:allow-show", "core:window:allow-set-focus", "core:window:allow-unminimize",
    "allow-net-fetch", "allow-net-cancel", "allow-file-save", "allow-file-download",
    "allow-open-external", "allow-notify", "allow-device-key", "allow-desktop-info",
    "allow-set-badge", "allow-set-tray-labels", "allow-autostart-get", "allow-autostart-set",
    "allow-update-check", "allow-update-install"
  ]
}
